# OpenWeatherMap API Key (Get a free API key at https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Optional: Concurrency limit (default is 10)
WEATHER_MAX_CONCURRENCY=10

# Optional: HTTP request timeout in seconds (default is 10.0)
WEATHER_REQUEST_TIMEOUT=10.0

# Optional: Comma-separated list of weather conditions triggering delays
# Default: Rain,Snow,Thunderstorm,Squall,Tornado,Ash
WEATHER_DELAY_CONDITIONS=Rain,Snow,Thunderstorm,Squall,Tornado,Ash
